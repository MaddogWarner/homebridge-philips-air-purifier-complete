{
  "name": "homebridge-philips-air-purifier-complete",
  "version": "5.0.0",
  "customUi": true,
  "description": "Homebridge plugin for Philips Air Purifiers (CoAP, HTTP, HomeID and Air+ cloud). No install scripts: needs only Python 3.11+",
  "main": "index.js",
  "files": [
    "index.js",
    "python-runtime.js",
    "philips_air_api.py",
    "aioairctrl/**/*.py",
    "vendor/**/*.py",
    "vendor/**/py.typed",
    "vendor/LICENSES/",
    "vendor/README.md",
    "vendor/VERSIONS.txt",
    "homebridge-ui/",
    "scripts/*.py",
    "config.schema.json",
    "requirements.txt",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "homebridge-plugin",
    "philips",
    "air-purifier",
    "homekit",
    "coap"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": ">=2.0.0"
  },
  "author": "MaddogWarner",
  "contributors": [
    "MaddogWarner",
    "OpenAI Codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaddogWarner/homebridge-philips-air-purifier-complete.git"
  },
  "homepage": "https://github.com/MaddogWarner/homebridge-philips-air-purifier-complete#readme",
  "bugs": {
    "url": "https://github.com/MaddogWarner/homebridge-philips-air-purifier-complete/issues"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "homebridge": "^2.5.0",
    "prettier": "^3.2.5"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests && node --test tests/js/*.js",
    "lint": "eslint .",
    "format": "prettier -w ."
  }
}
